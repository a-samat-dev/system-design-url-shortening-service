<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
          http://www.liquibase.org/xml/ns/mongodb
          http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <!-- Create collection -->
    <changeSet id="001-create-keys" author="samat">
        <mongodb:createCollection collectionName="keys"/>
    </changeSet>

    <!-- Unique index for short code -->
    <changeSet id="001-keys" author="samat">
        <mongodb:createIndex collectionName="keys">
            <mongodb:keys>{ "key": 1 }</mongodb:keys>
            <mongodb:options>
                { "unique": true, "name": "ux_keys" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>
